# ====================
# 生产环境身份验证配置（统一反向代理 + Basic Auth）
# ====================

# 环境标识（生产环境必须设置为 production）
NODE_ENV=production

# 内部服务地址（仅 Next.js 服务端可见，不暴露给浏览器）
INTERNAL_API_BASE_URL=http://127.0.0.1:8787
INTERNAL_X_API_BASE_URL=http://127.0.0.1:8788
INTERNAL_X_TRADITIONAL_API_BASE_URL=http://127.0.0.1:8791
INTERNAL_HOTSPOT_API_BASE_URL=http://127.0.0.1:8789
INTERNAL_CONTROL_API_BASE_URL=http://127.0.0.1:8790
INTERNAL_IMAGE_API_BASE_URL=http://127.0.0.1:8790

# 浏览器端 API 地址（通过反向代理访问，不暴露内部端口）
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_X_API_BASE_URL=/x-api
NEXT_PUBLIC_X_TRADITIONAL_API_BASE_URL=/x-traditional-api
NEXT_PUBLIC_HOTSPOT_API_BASE_URL=/hotspot-api
NEXT_PUBLIC_CONTROL_API_BASE_URL=/control-api
NEXT_PUBLIC_IMAGE_API_BASE_URL=/control-api

# 服务监听地址（生产环境建议绑定 127.0.0.1，通过反向代理访问）
API_HOST=127.0.0.1
X_API_HOST=127.0.0.1
X_TRADITIONAL_API_HOST=127.0.0.1
HOTSPOT_API_HOST=127.0.0.1

# CORS 白名单（逗号分隔，生产环境填写实际域名，如 https://ops.example.com）
# 如果通过统一代理访问且浏览器同源，可不设置或设为 false
CORS_ALLOWED_ORIGINS=

# ====================
# 原有配置（保持兼容）
# ====================

MYSQL_URL=mysql://root:your_password@127.0.0.1:6306/zhihu_mvp
API_PORT=8787
CONTROL_API_PORT=8790
HOTSPOT_API_PORT=8789
