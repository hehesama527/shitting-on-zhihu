HUMANIZER_SKILL_PATH=C:\Users\your_user\.codex\skills\humanizer-zh\SKILL.md
# 2026-09 产品定位切换为 Dudu 中转站。旧值（存档）：
# TOPIC_KEYWORDS=币圈新手，加密货币市场，币圈交易，交易策略，止盈止损，趋势和震荡判断，量化回测，策略验证，可视化回测
TOPIC_KEYWORDS=Claude Code，GPT API，大模型中转，AI编程工具，API访问不稳定，开发者工具，OpenRouter平替，API调用成本，AI辅助编程
ZHIHU_AGENT_MODEL=gpt-6-sol
ZHIHU_AGENT_BASE_URL=https://coding.dashscope.aliyuncs.com/v1
ZHIHU_AGENT_API_KEY=your_project_api_key
ZHIHU_AGENT_WIRE_API=chat_completions
ZHIHU_AGENT_REASONING_EFFORT=high
# Zhihu routing: topic/review/publish use this Dudu runtime.
# writer_agent is bound to a Volcengine model in data/model-center.json;
# when that Volcengine runtime hits quota, it falls back to this Dudu runtime.
OPS_AGENT_INTERVAL_MS=60000
OPS_AGENT_MODEL=claude-opus-4-6-thinking
OPS_AGENT_BASE_URL=https://apiapipp.com
OPS_AGENT_API_KEY=
OPS_AGENT_WIRE_API=chat_completions
OPS_AGENT_REASONING_EFFORT=high
