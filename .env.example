# Video Production Hub
VIDEO_AGENT_MODEL=gpt-5.5
VIDEO_AGENT_BASE_URL=
VIDEO_AGENT_API_KEY=
VIDEO_AGENT_WIRE_API=responses
VIDEO_AGENT_REASONING_EFFORT=high
